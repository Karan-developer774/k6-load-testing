# ==========================================
# Production .gitignore for k6 Load Testing Platform
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Generated Assets
dist/
build/
out/
.next/
dist-ssr/

# Local SQLite Databases & Ephemeral Storage
dev.db
dev.db-journal
*.sqlite
*.sqlite3
*.db
*.db-journal

# Ephemeral k6 Test Executions & Artifacts
metrics.json
summary.json
*.ndjson
k6_executions/

# Environment Variables & Secrets (Keep .env.example committed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & System Files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary Files
tmp/
temp/
