PORT=3001
HOST=0.0.0.0
# For local development SQLite:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/k6loadtest?schema=public"

K6_BIN_PATH="k6"
ALLOW_LOCAL_TARGETS="false"
MAX_VUS_CAP=5000
MAX_DURATION_SECONDS=3600
MAX_CONCURRENT_TESTS=2
JWT_SECRET="replace-with-a-secure-random-jwt-secret-string"
ENCRYPTION_KEY="replace-with-a-32-byte-hex-encryption-key"
